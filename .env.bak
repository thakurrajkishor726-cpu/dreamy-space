# Copy to .env and fill in. See SETUP.md for where each value comes from.
#
# EVERY value here is inlined into the JavaScript bundle and shipped to every
# visitor — Vite exposes anything prefixed with VITE_. Nothing in this file can
# be a secret. That is why there is no Cloudinary API key or secret below: they
# would grant full admin control of the media library to anyone who opened
# devtools. Uploads use an unsigned preset instead, whose authority is capped
# by the preset's own folder/format/size settings.
#
# The Firebase API key IS meant to be public — it identifies the project rather
# than authenticating anyone. firestore.rules and the `admins` collection are
# what actually protect the data.

TURSO_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3ODY2Mzc1OTEsImlkIjoiMDE5ZmZiZTUtY2EwMS03ZTE4LThhNWUtZjZmZTZkMDliNDU0Iiwia2lkIjoiY1VqZ0xvcXBhUjRaNnFWS2tHbFFYTFJaYU9XYTkxUmp6TnR4UFJZMTVYcyIsInJpZCI6IjZiMmJlZGEyLTJkMmUtNDA5NS05ZTM3LTYwMzY3OGM1NjM3MSJ9.BHBZwssdX402pye0y1fp4Z5qBUYErF_erI7OzwEYrzIBcG6u-hwcUetBH_xjMqi5z05FMcKz1mJcOnLp3DS4Ag
TURSO_URL=libsql://dreamy-spaces-sathwikshetty33.aws-ap-south-1.turso.io

# Optional — present in the console's copy-paste block but unused here. We
# never call Firebase Storage (Cloudinary replaces it) or Cloud Messaging, so
# these can be left blank.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# --- Cloudinary ----------------------------------------------------------
# Dashboard → Cloud name
VITE_CLOUDINARY_CLOUD_NAME=
# Settings → Upload → Upload presets → add one with signing mode UNSIGNED
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=creativenconcepts

# --- added: required by the FastAPI service ---
JWT_SECRET=mABnN4ylh_svkWDvH9JKHkdkliFrhHhsucEk8SSXzhoyKILJf7CVU41-83_OmJlV
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5177
