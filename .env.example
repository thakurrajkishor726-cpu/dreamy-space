# Copy to .env and fill in. See SETUP.md for where each value comes from.
#
# Anything prefixed with VITE_ is inlined into the JavaScript bundle and
# shipped to every visitor — nothing under that prefix can be a secret.
# Everything below the divider is server-side only and never reaches a browser.

# ==========================================================================
# CLIENT (ships in the bundle)
# ==========================================================================

# Where the FastAPI service lives. Leave blank in development — Vite proxies
# /api to localhost:8000. Set it only if the API is on another origin.
VITE_API_BASE_URL=

# Cosmetic default for upload folders; the server decides the real one.
VITE_CLOUDINARY_FOLDER=dreamyspaces


# ==========================================================================
# SERVER ONLY — never prefix these with VITE_
# ==========================================================================

# --- Turso (Database → your database → Connect) --------------------------
TURSO_URL=
TURSO_TOKEN=

# --- Sessions ------------------------------------------------------------
# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_HOURS=12

# --- Cloudinary (Dashboard → API keys) -----------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# A REAL secret: it grants full admin control of your media library.
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dreamyspaces

# Comma-separated origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local development without Turso: leave TURSO_* blank and the API uses this
# SQLite file instead.
# CATALOGUE_DB_PATH=catalogue.db
